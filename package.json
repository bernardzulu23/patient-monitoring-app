{
  "name": "patient-monitor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "prisma generate && node scripts/migrate-safe.js && next build --webpack",
    "postinstall": "prisma generate",
    "start": "next start",
    "start:lan": "next start -H 0.0.0.0 -p 3000",
