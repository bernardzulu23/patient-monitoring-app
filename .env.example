# Neon (cloud demo / Vercel) — use pooled + unpooled URLs from Neon Console
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"
# DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# --- Rural hospital on-prem (docker compose Postgres) ---
# Start DB: docker compose up -d db (reads POSTGRES_PASSWORD from this file)
POSTGRES_PASSWORD="replace-with-a-strong-db-password"
DATABASE_URL="postgresql://pm:replace-with-a-strong-db-password@127.0.0.1:5432/patient_monitor"
DATABASE_URL_UNPOOLED="postgresql://pm:replace-with-a-strong-db-password@127.0.0.1:5432/patient_monitor"

# Set to 1 only when a reverse proxy you control (deploy/Caddyfile) overwrites
# X-Forwarded-For. Without it, login/contact rate limits use one shared bucket.
# TRUST_PROXY=1

# Signed session cookies — at least 32 random characters
# Generate: openssl rand -base64 32
SESSION_SECRET="replace-with-a-random-32-plus-character-string"

# Optional: bind hostname shown in logs / PWA install notes
# HOSTNAME=0.0.0.0
