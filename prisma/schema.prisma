generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // DATABASE_URL = Neon pooled (-pooler) — used by the app on Vercel
  // DATABASE_URL_UNPOOLED = Neon direct — used by Prisma Migrate
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Ward {
  id        String   @id @default(cuid())
  name      String
  rooms     Room[]
  users     User[]
  createdAt DateTime @default(now())
}

model Room {
  id        String    @id @default(cuid())
  wardId    String
  ward      Ward      @relation(fields: [wardId], references: [id])
  number    String
  patients  Patient[]
  devices   Device[]
  createdAt DateTime  @default(now())

  @@unique([wardId, number])
}

model Patient {
  id                String                    @id @default(cuid())
  roomId            String
  room              Room                      @relation(fields: [roomId], references: [id])
  fullName          String
  patientCode       String                    @unique
  age               Int?
  sex               String?
  admissionReason   String?
  status            String                    @default("ACTIVE") // ACTIVE | DISCHARGED
  admittedAt        DateTime                  @default(now())
  dischargedAt      DateTime?
  devices           Device[]
  thresholdOverride PatientThresholdOverride?
}

model Device {
  id         String    @id @default(cuid())
  patientId  String?
  patient    Patient?  @relation(fields: [patientId], references: [id])
  roomId     String?
  room       Room?     @relation(fields: [roomId], references: [id])
  deviceName String
  apiKey     String    @unique
  lastSeen   DateTime?
  readings   Reading[]
  alerts     Alert[]
}

model Reading {
  id         String   @id @default(cuid())
  deviceId   String
  device     Device   @relation(fields: [deviceId], references: [id])
  heartRate  Int?
  spo2       Int?
  tempC      Float?
  systolic   Int?
  diastolic  Int?
  recordedAt DateTime @default(now())
  alerts     Alert[]
}

model Alert {
  id               String    @id @default(cuid())
  deviceId         String
  device           Device    @relation(fields: [deviceId], references: [id])
  readingId        String?
  reading          Reading?  @relation(fields: [readingId], references: [id])
  alertType        String
  status           String    @default("ACTIVE") // ACTIVE | ACKNOWLEDGED | RESOLVED
  value            Float?
  acknowledgedAt   DateTime?
  acknowledgedById String?
  acknowledgedBy   User?     @relation("AlertAcks", fields: [acknowledgedById], references: [id], onDelete: SetNull)
  sentViaSms       Boolean   @default(false)
  createdAt        DateTime  @default(now())
  resolvedAt       DateTime?

  @@index([status, createdAt])
  @@index([deviceId, alertType, status])
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  role         String // "admin" | "doctor" | "nurse"
  displayName  String?
  staffId      String?
  phone        String?
  wardId       String?
  ward         Ward?      @relation(fields: [wardId], references: [id])
  auditLogs    AuditLog[]
  alertAcks    Alert[]    @relation("AlertAcks")
}

// Next steps (out of scope for this project): field-level encryption of AuditLog
// payloads and MFA on privileged accounts. This table is append-only — no update/delete UI.
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  targetType String
  targetId   String
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([action])
}

/** Admin-managed images for the public landing page (stored in DB for Vercel-friendly demos). */
model LandingImage {
  id           String   @id @default(cuid())
  slot         String // "HERO" | "GALLERY"
  fileName     String
  mimeType     String
  data         Bytes
  uploadedById String?
  createdAt    DateTime @default(now())

  @@index([slot])
}

/** Hospital-wide vital threshold defaults (admin-configurable). Placeholders — not medical advice. */
model HospitalThresholds {
  id        String   @id @default("default")
  tempLow   Float    @default(35)
  tempHigh  Float    @default(38.5)
  hrLow     Int      @default(50)
  hrHigh    Int      @default(120)
  spo2Low   Int      @default(92)
  sysLow    Int      @default(90)
  sysHigh   Int      @default(180)
  updatedAt DateTime @updatedAt
  updatedById String?
}

/** Optional per-patient threshold overrides (null field = use hospital default). */
model PatientThresholdOverride {
  id        String  @id @default(cuid())
  patientId String  @unique
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  tempLow   Float?
  tempHigh  Float?
  hrLow     Int?
  hrHigh    Int?
  spo2Low   Int?
  sysLow    Int?
  sysHigh   Int?
  updatedAt DateTime @updatedAt
}
