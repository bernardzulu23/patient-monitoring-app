generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // DATABASE_URL = Neon pooled (-pooler) — used by the app on Vercel
  // DATABASE_URL_UNPOOLED = Neon direct — used by Prisma Migrate
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Ward {
  id        String   @id @default(cuid())
  name      String
  rooms     Room[]
  users     User[]
  createdAt DateTime @default(now())
}

model Room {
  id        String    @id @default(cuid())
  wardId    String
  ward      Ward      @relation(fields: [wardId], references: [id])
  number    String
  patients  Patient[]
  createdAt DateTime  @default(now())

  @@unique([wardId, number])
}

model Patient {
  id          String   @id @default(cuid())
  roomId      String
  room        Room     @relation(fields: [roomId], references: [id])
  fullName    String
  patientCode String   @unique
  admittedAt  DateTime @default(now())
  devices     Device[]
}

model Device {
  id         String    @id @default(cuid())
  patientId  String
  patient    Patient   @relation(fields: [patientId], references: [id])
  deviceName String
  apiKey     String    @unique
  lastSeen   DateTime?
  readings   Reading[]
  alerts     Alert[]
}

model Reading {
  id         String   @id @default(cuid())
  deviceId   String
  device     Device   @relation(fields: [deviceId], references: [id])
  heartRate  Int?
  spo2       Int?
  tempC      Float?
  systolic   Int?
  diastolic  Int?
  recordedAt DateTime @default(now())
  alerts     Alert[]
}

model Alert {
  id         String   @id @default(cuid())
  deviceId   String
  device     Device   @relation(fields: [deviceId], references: [id])
  readingId  String
  reading    Reading  @relation(fields: [readingId], references: [id])
  alertType  String // NEWS2-inspired levels e.g. "NEWS2_URGENT", "NEWS2_LOW"
  sentViaSms Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  role         String // "admin" | "doctor" | "nurse"
  wardId       String?
  ward         Ward?      @relation(fields: [wardId], references: [id])
  auditLogs    AuditLog[]
}

// Next steps (out of scope for this project): field-level encryption of AuditLog
// payloads and MFA on privileged accounts. This table is append-only — no update/delete UI.
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String // e.g. "CREATED_PATIENT", "DELETED_WARD", "ADDED_DEVICE"
  targetType String // e.g. "Patient", "Ward"
  targetId   String
  createdAt  DateTime @default(now())

  @@index([createdAt])
}
